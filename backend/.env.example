PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/url_shortener?schema=public"
REDIS_URL="redis://localhost:6379"
CORS_ORIGIN="http://localhost:5173"
DEFAULT_CACHE_TTL_SECONDS=3600
SHORT_CODE_LENGTH=6

# Google OAuth (optional -- omit all three to keep sign-in disabled; see design D4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

APP_BASE_URL="http://localhost:5173"
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=sid

ANON_LINK_TTL_HOURS=24
ANON_CLEANUP_ENABLED=false
ANON_CLEANUP_INTERVAL_MINUTES=60
